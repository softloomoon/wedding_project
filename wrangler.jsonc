{
  // Cloudflare Workers 설정. name 은 지금 배포된 Worker 이름(wedding-project)과 같아야 합니다.
  "name": "wedding-project",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api, 테스트 주소, 메인·질문방(검색엔진용 HTML을 미리 채워 보내요), robots·sitemap·ads.txt 는 Worker 가 먼저 받아요
    "run_worker_first": ["/", "/index.html", "/qna", "/qna/", "/qna/index.html", "/robots.txt", "/sitemap.xml", "/ads.txt", "/api/*", "/values", "/values/*", "/test3", "/test3/*", "/balance", "/balance/*"]
  },
  // 익명 질문방 저장소 (Durable Object, SQLite). 배포할 때 자동으로 만들어져서 대시보드에서 따로 만들 필요가 없어요.
  "durable_objects": {
    "bindings": [{ "name": "QUESTION_BOARD", "class_name": "QuestionBoard" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QuestionBoard"] }],
  "vars": {
    // 새 질문·의견·신고 알림을 받을 운영자 메일
    "ADMIN_EMAIL": "softloomon@gmail.com",
    // "false": 새 질문도 승인 없이 바로 공개 (지금 설정) / "true": 운영자가 승인해야 공개
    // 바로 공개여도 운영자 메일로 새 질문 알림과 '숨기기' 링크가 오고, 신고 3회면 자동으로 숨겨져요.
    "REVIEW_QUESTIONS": "false",
    // Cloudflare Turnstile 을 쓰려면 사이트 키를 넣고 TURNSTILE_SECRET 시크릿을 추가하세요. (선택)
    "TURNSTILE_SITE_KEY": "",
    // 쉼표로 구분한 추가 금칙어 (선택)
    "BANNED_WORDS": ""
  },
  // 미리보기(Preview) 배포용 설정. 브랜치나 PR 을 올리면 Cloudflare 가 미리보기 주소를 만드는데, 그때 이 값을 씁니다.
  // 미리보기마다 Durable Object 저장소가 따로 생겨서 실제 사이트의 질문·의견과 섞이지 않아요.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "QUESTION_BOARD", "class_name": "QuestionBoard" }]
    },
    "vars": {
      // 미리보기에서는 운영자 메일 알림을 보내지 않고, 질문도 바로 공개해서 테스트하기 쉽게 합니다.
      "ADMIN_EMAIL": "",
      "REVIEW_QUESTIONS": "false",
      "TURNSTILE_SITE_KEY": "",
      "BANNED_WORDS": ""
    }
  }
  // 시크릿(대시보드 > Settings > Variables and Secrets 에서 'Secret'으로 추가): ADMIN_KEY, MAIL_WEBHOOK_URL, MAIL_SECRET, TURNSTILE_SECRET(선택)
}
